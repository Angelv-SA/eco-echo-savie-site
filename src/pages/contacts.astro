---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contacts" description="Contacter Eco Echo Savie — Dr Viviane Zoéwintalé Sawadogo, Ouagadougou, Burkina Faso.">
  <section class="border-b border-ink/10 bg-sage">
    <div class="max-w-4xl mx-auto px-6 py-16 md:py-24">
      <p class="text-sm uppercase tracking-wide text-ink/50 mb-3">Contacts</p>
      <h1 class="font-display text-3xl md:text-4xl text-forest leading-tight max-w-2xl">
        Prendre contact avec Eco Echo Savie
      </h1>
      <p class="mt-8 text-base md:text-lg leading-relaxed text-ink/85 max-w-prose">
        Chercheurs, institutions, universités, partenaires : n'hésitez pas à nous écrire pour
        toute question, collaboration ou demande d'accompagnement.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-16 md:py-20 grid gap-14 md:grid-cols-2">
    <div>
      <h2 class="font-display text-xl text-forest mb-6">Coordonnées</h2>
      <dl class="space-y-5 text-ink/85">
        <div>
          <dt class="text-xs uppercase tracking-wide text-ink/50">Fondatrice</dt>
          <dd class="mt-1">Dr Viviane Zoéwintalé Sawadogo, PhD</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-ink/50">Adresse postale</dt>
          <dd class="mt-1">09 BP Ouagadougou 1060, Burkina Faso</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-ink/50">Téléphone</dt>
          <dd class="mt-1">
            <a href="tel:+22651077071" class="hover:text-forest">+226 51 07 70 71</a><br />
            <a href="tel:+22654604098" class="hover:text-forest">+226 54 60 40 98</a>
          </dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-ink/50">Email</dt>
          <dd class="mt-1">
            <a href="mailto:vivianesawadogo@yahoo.fr" class="hover:text-forest">vivianesawadogo@yahoo.fr</a>
          </dd>
        </div>
      </dl>

      <blockquote class="mt-12 border-t border-ink/15 pt-6">
        <p class="font-display italic text-ink/80 leading-relaxed">
          "We are called to assist the Earth to heal her wounds and, in the process, heal our own."
        </p>
        <footer class="mt-3 text-sm text-ink/50">— Wangari Maathai</footer>
      </blockquote>
    </div>

    <div>
      <h2 class="font-display text-xl text-forest mb-6">Écrivez-nous</h2>
      <form action="https://formspree.io/f/VOTRE_ID_FORMSPREE" method="POST" class="space-y-5">
        <div>
          <label for="name" class="block text-sm text-ink/70 mb-1">Nom complet</label>
          <input type="text" id="name" name="name" required class="w-full border border-ink/20 rounded px-4 py-2.5 bg-ivory focus:border-forest focus:outline-none" />
        </div>
        <div>
          <label for="email" class="block text-sm text-ink/70 mb-1">Email</label>
          <input type="email" id="email" name="email" required class="w-full border border-ink/20 rounded px-4 py-2.5 bg-ivory focus:border-forest focus:outline-none" />
        </div>
        <div>
          <label for="message" class="block text-sm text-ink/70 mb-1">Message</label>
          <textarea id="message" name="message" rows="5" required class="w-full border border-ink/20 rounded px-4 py-2.5 bg-ivory focus:border-forest focus:outline-none"></textarea>
        </div>
        <button
          type="submit"
          class="inline-flex items-center px-6 py-3 bg-forest text-ivory text-sm font-medium rounded hover:bg-forest-dark transition-colors"
        >
          Envoyer le message
        </button>
      </form>
    </div>
  </section>
</Layout>
