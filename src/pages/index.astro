---
import Layout from "../layouts/Layout.astro";

const piliers = [
  {
    numero: "1",
    nom: "Penser",
    description: "La vision scientifique d'Eco Echo Savie et les fondements de l'écologie traditionnelle africaine.",
    href: "/penser",
  },
  {
    numero: "2",
    nom: "Rechercher",
    description: "Les travaux, publications, projets en cours et le Research Agenda.",
    href: "/rechercher",
  },
  {
    numero: "3",
    nom: "Agir",
    description: "Le cabinet, le conseil stratégique, les formations, la recherche appliquée.",
    href: "/agir",
  },
  {
    numero: "4",
    nom: "Collaborer",
    description: "Les réseaux, universités, institutions, partenaires et conférences.",
    href: "/collaborer",
  },
  {
    numero: "5",
    nom: "Transmettre",
    description: "Le Journal, les ressources pédagogiques, vidéos, interviews et bibliographies.",
    href: "/transmettre",
  },
];
---

<Layout title="Accueil">
  <!-- Hero -->
  <section class="border-b border-ink/10">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid lg:grid-cols-[1fr,1.15fr] gap-12 items-center">
      <div>
        <p class="font-display text-2xl md:text-4xl leading-tight text-forest max-w-xl">
          Comment répondre à la crise écologique contemporaine&nbsp;?
        </p>

        <p class="mt-8 text-base md:text-lg text-ink/80 max-w-xl leading-relaxed">
          Explorer l'écologie traditionnelle africaine comme un champ scientifique à part
          entière afin de contribuer, en dialogue avec les sciences contemporaines, à la
          réflexion mondiale sur les réponses à la crise écologique.
        </p>

        <p class="mt-10 font-display italic text-lg text-clay">
          « Penser l'écologie depuis l'Afrique. Dialoguer avec le monde. »
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/penser"
            class="inline-flex items-center px-6 py-3 bg-forest text-ivory text-sm font-medium rounded hover:bg-forest-dark transition-colors"
          >
            Découvrir notre vision
          </a>
          <a
            href="/contacts"
            class="inline-flex items-center px-6 py-3 border border-forest text-forest text-sm font-medium rounded hover:bg-forest hover:text-ivory transition-colors"
          >
            Nous contacter
          </a>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -bottom-5 -right-5 w-full h-full bg-gold -z-10 rounded-sm hidden md:block"></div>
        <img
          src="/images/communaute.webp"
          alt="Scène de vie communautaire au bord d'une rivière, en harmonie avec la nature"
          class="w-full aspect-[3/2] object-cover rounded-sm shadow-lg"
        />
      </div>
    </div>
  </section>

  <!-- Cinq piliers -->
  <section class="max-w-6xl mx-auto px-6 py-20">
   <p class="text-sm uppercase tracking-wide text-ink/50 mb-2">Notre plateforme construit autour de cinq piliers</p>
<h2 class="font-display text-2xl md:text-3xl text-ink mb-12 tracking-wide md:tracking-widest">
  Penser · Rechercher · Agir · Collaborer · Transmettre
</h2>

    <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {piliers.map((pilier) => (
        <a href={pilier.href} class="group block relative pt-6">
          <div class="absolute top-0 left-0 h-[2px] w-10 bg-clay group-hover:w-full transition-all duration-300"></div>
          <span class="font-display text-base text-clay">{pilier.numero}</span>
          <h3 class="font-display text-2xl md:text-3xl text-forest mt-2 group-hover:text-forest-dark transition-colors">
            {pilier.nom}
          </h3>
          <p class="mt-3 text-base text-ink/70 leading-relaxed max-w-xs">{pilier.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
