---
import Layout from "../layouts/Layout.astro";

const rubriques = [
  { nom: "Axes de recherche", description: "Les grandes orientations scientifiques développées par la fondatrice." },
  { nom: "Projets en cours", description: "Les programmes de recherche appliquée actuellement menés." },
  { nom: "Publications", description: "Articles, chapitres d'ouvrages et contributions scientifiques." },
  { nom: "Livre(s)", description: "Les ouvrages publiés par la fondatrice." },
  { nom: "Communications", description: "Interventions lors de colloques et conférences scientifiques." },
  { nom: "Collaborations scientifiques", description: "Chercheurs, laboratoires et institutions partenaires." },
];
---

<Layout title="Rechercher" description="L'activité scientifique d'Eco Echo Savie : axes de recherche, publications, projets et Research Agenda.">
  <section class="border-b border-ink/10 bg-sage">
    <div class="max-w-4xl mx-auto px-6 py-16 md:py-24">
      <p class="text-sm uppercase tracking-wide text-ink/50 mb-3">2 · Rechercher</p>
      <h1 class="font-display text-3xl md:text-4xl text-forest leading-tight max-w-2xl">
        La recherche est le cœur d'Eco Echo Savie
      </h1>
      <p class="mt-8 text-base md:text-lg leading-relaxed text-ink/85 max-w-prose">
        Le cabinet est l'un des moyens de diffuser cette recherche. Cette rubrique met en
        valeur l'activité scientifique de la fondatrice : ses axes de recherche, ses projets,
        ses publications et ses collaborations.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-16 md:py-20">
    <div class="grid sm:grid-cols-2 gap-x-8 gap-y-10">
      {rubriques.map((r) => (
        <div class="border-t border-ink/15 pt-4">
          <h2 class="font-display text-lg text-forest">{r.nom}</h2>
          <p class="mt-2 text-sm text-ink/70 leading-relaxed">{r.description}</p>
          <p class="mt-3 text-xs uppercase tracking-wide text-clay">Contenu à venir</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-ink/10 bg-forest text-ivory">
    <div class="max-w-4xl mx-auto px-6 py-16 md:py-20">
      <p class="text-sm uppercase tracking-wide text-ivory/60 mb-3">Research Agenda</p>
      <p class="text-base md:text-lg leading-relaxed text-ivory/90 max-w-prose">
        Cette section reprendra les grandes orientations de la notice scientifique destinée au
        ministère de l'enseignement supérieur — le programme scientifique des prochaines années.
      </p>
      <a
        href="/agir"
        class="mt-8 inline-flex items-center px-6 py-3 bg-ivory text-forest text-sm font-medium rounded hover:bg-gold hover:text-ink transition-colors"
      >
        Voir la rubrique Agir
      </a>
    </div>
  </section>
</Layout>
